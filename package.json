{
  "name": "claude-code-enhancer",
  "version": "2.0.0",
  "description": "Claude Code 增强工具集 - Node.js 版本",
  "type": "module",
  "bin": {
    "aiagent-notify": "dist/aiagent-notify.js",
    "setup-claude": "dist/setup-claude.js",
    "skill-install": "dist/skill-install.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "postbuild": "node build-tools/add-shebang.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "dotenv": "^16.4.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@vitest/ui": "^4.0.8",
    "c8": "^10.1.3",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^4.0.8"
  }
}
